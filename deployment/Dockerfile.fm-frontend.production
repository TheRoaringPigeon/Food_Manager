FROM node:20-alpine AS builder
WORKDIR /app
COPY fm_frontend/package*.json ./
RUN npm ci
COPY fm_frontend/ .
ARG VITE_BASE_PATH=/food-manager
ENV VITE_BASE_PATH=$VITE_BASE_PATH
RUN npm run build

FROM nginx:alpine
# Copy the built SPA into a subdirectory matching the base path so nginx can
# serve /food-manager/assets/... paths directly from the filesystem.
COPY --from=builder /app/dist /usr/share/nginx/html/food-manager
COPY deployment/configs/nginx/fm-frontend.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
