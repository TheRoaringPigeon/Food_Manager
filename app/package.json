  },
  "homepage": "https://github.com/TheRoaringPigeon/Food_Manager#readme",
  "description": "",
  "dependencies": {
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "lodash": "^4.17.21"
  }
