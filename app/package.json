{
  "name": "food_manager",
  "version": "1.0.0",
  "main": "app.js",
  "scripts": {
    "start": "node index.js",
    "dev": "npm run dev:server",
    "dev:server": "nodemon server.js",
    "dev:client": "cd client && npm run dev",
    "dev:both": "concurrently \"npm run dev:server\" \"cd client && npm run dev\"",
    "build": "cd client && npm run build",
    "install:deps": "npm install && cd client && npm install",
    "clean": "cd client && npm run clean",
    "lint": "cd client && npm run lint",
    "test": "echo \"Error: no test specified\" && exit 1",
    "db:create": "node scripts/createDatabase.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "db:reset": "node scripts/reset.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheRoaringPigeon/Food_Manager.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/TheRoaringPigeon/Food_Manager/issues"
  },
  "homepage": "https://github.com/TheRoaringPigeon/Food_Manager#readme",
  "description": "",
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^4.21.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "lodash": "^4.17.21",
    "morgan": "^1.10.0",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.35.0"
  }
}
